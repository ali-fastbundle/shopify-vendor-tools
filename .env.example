# ---------------------------------------------------------------------------
# Matcher. Set either key, or both. With both, one is tried if the other fails.
# MATCH_PROVIDER pins which goes first; leave it unset to prefer Anthropic.
# With neither key the matcher 503s and the UI falls back to local keyword
# matching, which works but is noticeably blunter.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# "anthropic" or "openai". Optional.
MATCH_PROVIDER=

# ---------------------------------------------------------------------------
# Durable storage for votes, reviews and suggestions.
# Add a Redis store from the Vercel dashboard and these arrive automatically.
# Either naming works, depending on which Marketplace provider you pick.
# Without them the app runs but forgets everything on each cold start.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Hold new suggestions back until you approve them by hand.
MODERATE_SUGGESTIONS=true

# ---------------------------------------------------------------------------
# Accounts and listing claims.
# AUTH_SECRET signs the session cookie. Generate one with:
#   openssl rand -base64 32
# Without it, sign-in is disabled and the directory stays read-only.
# ---------------------------------------------------------------------------
# It also signs the unsubscribe links on subscriber email, so changing it
# invalidates every link already sent.
AUTH_SECRET=

# Sign-in links, subscribe confirmations and broadcasts all go through Resend.
# Required in production; without it locally the mail is printed to the server
# log instead, which is enough to click an unsubscribe link while developing.
RESEND_API_KEY=
EMAIL_FROM=Directory <onboarding@resend.dev>

# Comma-separated. These addresses can edit any listing, reach /admin, send to
# the subscriber list, and receive the notification email.
ADMIN_EMAILS=
